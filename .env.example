# ── EarthIQ Core — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored; never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://earthiq:earthiq@localhost:5432/earthiq

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS (JSON array of allowed origins) ──────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=EarthIQ Core
APP_VERSION=0.1.0

# ── Map Tiles (optional — CARTO free basemaps work without a key) ─────────────
MAPTILER_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
