# ── EarthIQ Core — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.
# The .env file is git-ignored; never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://earthiq:earthiq@localhost:5432/earthiq

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── CORS (JSON array of allowed origins) ──────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=EarthIQ Core
APP_VERSION=0.1.0

# ── Map Tiles (optional — CARTO free basemaps work without a key) ─────────────
MAPTILER_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Object Storage (RustFS / S3-compatible) ───────────────────────────────────
# RustFS credentials (also used in docker-compose for the rustfs service)
RUSTFS_ACCESS_KEY=earthiq
RUSTFS_SECRET_KEY=earthiq
# Backend connection settings
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=earthiq
STORAGE_SECRET_KEY=earthiq
STORAGE_BUCKET=earthiq
STORAGE_REGION=us-east-1
# RustFS web console: http://localhost:9001 (login: earthiq / earthiq)

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email sending entirely (invite links still work)
# Example for Gmail: smtp_host=smtp.gmail.com, smtp_port=587, smtp_tls=true
# Example for Mailhog (local dev): smtp_host=localhost, smtp_port=1025, smtp_tls=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@earthiq.io
SMTP_TLS=true

# ── Share / Invite links ──────────────────────────────────────────────────────
# Base URL of the frontend, used to generate invite accept links in emails
FRONTEND_URL=http://localhost:3000
