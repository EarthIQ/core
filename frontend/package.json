{
  "name": "with-vite-react",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "prettier --config ./prettier.config.mjs --ignore-path ./.prettierignore --write . ../modules",
    "format:check": "prettier --config ./prettier.config.mjs --ignore-path ./.prettierignore --check . ../modules",
    "lint": "pnpm -r lint",
    "preview": "pnpm -r preview"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@9.15.0"
}
