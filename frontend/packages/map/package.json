{
  "name": "@packages/map",
  "version": "1.0.0",
  "description": "A comprehensive React map library based on MapLibre GL and Deck.gl",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "docs": "typedoc --out docs src/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish --access public",
    "release:beta": "npm run build && npm publish --tag beta --access public",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.6",
    "@deck.gl/core": "^9.2.6",
    "@deck.gl/geo-layers": "^9.2.6",
    "@deck.gl/layers": "^9.2.6",
    "@deck.gl/mesh-layers": "^9.2.6",
    "@packages/ui": "workspace:*",
    "@turf/area": "^7.3.4",
    "@turf/bearing": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "@turf/length": "^7.3.4",
    "@turf/turf": "^7.3.4",
    "apache-arrow": "^15.0.2",
    "flatgeobuf": "^3.38.0",
    "geotiff": "^2.1.3",
    "gif.js": "^0.2.0",
    "hyparquet": "^0.9.10",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^5.17.0",
    "nanoid": "^5.1.6",
    "pmtiles": "^3.2.1",
    "terra-draw": "^1.28.8",
    "terra-draw-maplibre-gl-adapter": "^1.3.0",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-onboarding": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/gif.js": "^0.2.5",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^10.2.8",
    "jsdom": "^24.1.3",
    "jspdf": "^2.5.1",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.1.18",
    "typedoc": "^0.25.13",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "optionalDependencies": {
    "jspdf": "^2.5.2",
    "proj4": "^2.20.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
