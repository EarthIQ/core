{
  "name": "@packages/map",
  "version": "1.0.0",
  "description": "A comprehensive React map library based on MapLibre GL and Deck.gl",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "docs": "typedoc --out docs src/index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish --access public",
    "release:beta": "npm run build && npm publish --tag beta --access public",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.10",
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/geo-layers": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mesh-layers": "^9.3.10",
    "@packages/ui": "workspace:*",
    "@turf/area": "^7.4.0",
    "@turf/bearing": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/turf": "^7.4.0",
    "apache-arrow": "^21.2.0",
    "flatgeobuf": "^4.4.0",
    "geotiff": "^3.0.5",
    "gif.js": "^0.2.0",
    "hyparquet": "^1.29.1",
    "lodash": "^4.17.23",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "nanoid": "^6.0.1",
    "pmtiles": "^4.5.0",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.3.0",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@packages/eslint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/geojson": "^7946.0.16",
    "@types/gif.js": "^0.2.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.18",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "optionalDependencies": {
    "jspdf": "^4.2.1",
    "proj4": "^2.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
